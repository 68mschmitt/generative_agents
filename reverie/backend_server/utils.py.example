# Copy to reverie/backend_server/utils.py and adjust for your machine.

# Use "ollama" for a local Ollama server or "openai" for the original setup.
llm_provider = "ollama"
llm_api_base = "http://localhost:11434/v1"  # Ollama OpenAI-compatible endpoint

# Ollama ignores the key but the OpenAI client requires a non-empty value.
openai_api_key = "ollama"
key_owner = "local"

# Pull these first, or replace with model names from `ollama list`.
#   ollama pull mistral:7b
#   ollama pull nomic-embed-text
llm_chat_model = "mistral:7b"
llm_gpt4_model = llm_chat_model
llm_completion_model = llm_chat_model
llm_embedding_model = "nomic-embed-text"

# Optional tracing and caches. Tracing is off by default and writes JSONL only
# when enabled.
llm_trace_enabled = False
llm_trace_path = "llm_trace.jsonl"
llm_embedding_cache_path = None

# Modern LLM architecture flags. Defaults reduce hot-path micro-calls while
# preserving legacy fallbacks for comparison/debugging.
llm_generate_emojis = False
llm_generate_event_triples = False
llm_score_poignancy = False
llm_compile_actions = False
structured_daily_planning = True
batched_conversations = True
structured_reflection = True

# Optional model routing aliases for future prompt tiers.
llm_fast_model = llm_chat_model
llm_reasoning_model = llm_gpt4_model

maze_assets_loc = "../../environment/frontend_server/static_dirs/assets"
env_matrix = f"{maze_assets_loc}/the_ville/matrix"
env_visuals = f"{maze_assets_loc}/the_ville/visuals"

fs_storage = "../../environment/frontend_server/storage"
fs_temp_storage = "../../environment/frontend_server/temp_storage"

collision_block_id = "32125"
debug = True
